# WCSim macro template for mu+ -> Michel positron production
# The placeholders @SEED@, @ENERGY@ and @OUTPUT_FILE@
# are replaced automatically by the SLURM batch script.

/WCSim/random/generator HEPJAMES
/WCSim/random/seed @SEED@ default

/run/verbose 0
/tracking/verbose 0
/hits/verbose 0
/grdm/verbose 0


# Detector geometry
/WCSim/WCgeom HyperK_HybridmPMT_WithOD_Realistic
/WCSim/Construct


# PMT configuration
/WCSim/PMTQEMethod SensitiveDetector_Only
/WCSim/PMTCollEff on
/WCSim/SavePi0 false


# Digitizer and trigger
/DAQ/Digitizer SKI
/DAQ/Trigger NDigits

/control/execute macros/daq.mac


# Dark noise
/DarkRate/SetDetectorElement tank
/DarkRate/SetDarkMode 1
/DarkRate/SetDarkHigh 100000
/DarkRate/SetDarkLow 0
/DarkRate/SetDarkWindow 4000


# Modify the mu+ lifetime
/particle/select mu+
/particle/property/stable false
/particle/property/lifetime 0.5 us
/particle/property/dump


# Particle gun
/mygen/generator gun
/gun/particle mu+
/gun/direction 1 0 0
/gun/position 0 0 0
/gun/energy @ENERGY@ MeV


# Output
/WCSimIO/RootFile /output_data/@OUTPUT_FILE@


# Events at this energy
/run/beamOn 1000