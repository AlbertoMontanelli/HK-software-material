#!/bin/bash
#SBATCH --job-name=run_WCSim
#SBATCH --output=logs/run_WCSim_%j.out
#SBATCH --error=logs/run_WCSim_%j.err
#SBATCH --partition=levante
#SBATCH --account=default
#SBATCH --time=12:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=4G

set -euo pipefail

MACRO_FILE="$1"

# Directory from which sbatch was launched.
BASE_DIR="${SLURM_SUBMIT_DIR}"

MACRO_PATH="${BASE_DIR}/src/WCSim_macros/${MACRO_FILE}"
OUTPUT_DIR="${BASE_DIR}/data/WCSim_data"
IMAGE_PATH="${BASE_DIR}/WCSim.sif"

apptainer run \
    --bind "${OUTPUT_DIR}:/output_data" \
    --bind "${BASE_DIR}/src/WCSim_macros:/WCSim_macros" \
    "${IMAGE_PATH}" \
    "/WCSim_macros/${MACRO_FILE}" \
    "/opt/WCSim/install/macros/tuning_parameters_hkfd.mac"