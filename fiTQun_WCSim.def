Bootstrap: localimage
From: ./fiTQun_latest.sif

%post
    set -e

    echo "=== Building test image: fiTQun + Geant4 + full WCSim ==="

    # ==============================================================
    # 1. Path already present in fiTQun image
    # ==============================================================

    export FITQUN_SRC=/usr/local/hk/fiTQun
    export FITQUN_INSTALL=/usr/local/hk/fiTQun/install-Linux_x86_64-gcc_8-python_3.12.1
    export WCSIMROOT_INSTALL=/usr/local/hk/WCSimRoot/install-Linux_x86_64-gcc_8-python_3.12.1
    export ROOT_INSTALL=/usr/local/hk/ROOT/install-Linux_x86_64-gcc_8-python_3.12.1

    export FITQUN_ROOT=${FITQUN_SRC}

    export PATH=${FITQUN_INSTALL}/bin:${ROOT_INSTALL}/bin:$PATH
    export LD_LIBRARY_PATH=${FITQUN_INSTALL}/lib:${WCSIMROOT_INSTALL}/lib:${ROOT_INSTALL}/lib:$LD_LIBRARY_PATH
    export ROOT_INCLUDE_PATH=${WCSIMROOT_INSTALL}/include/WCSimRoot:${WCSIMROOT_INSTALL}/include:$ROOT_INCLUDE_PATH

    # ROOT setup
    if [ -f ${ROOT_INSTALL}/bin/thisroot.sh ]; then
        source ${ROOT_INSTALL}/bin/thisroot.sh
    fi

    echo "ROOT version:"
    root-config --version

    # ==============================================================
    # 2. Install compilation tools if necessary
    # ==============================================================

    if command -v apt-get >/dev/null 2>&1; then
        apt-get update
        apt-get install -y git cmake make gcc g++ wget curl ca-certificates expat libexpat1-dev
        apt-get clean
        rm -rf /var/lib/apt/lists/*
    elif command -v dnf >/dev/null 2>&1; then
        dnf install -y git cmake make gcc gcc-c++ wget curl ca-certificates expat-devel
        dnf clean all
    elif command -v yum >/dev/null 2>&1; then
        yum install -y git cmake make gcc gcc-c++ wget curl ca-certificates expat-devel
        yum clean all
    else
        echo "ERROR: no apt-get/dnf/yum found. Install build tools manually or use another base image."
        exit 1
    fi

    # ==============================================================
    # 3. Install Geant4
    # ==============================================================
    #
    # Nota: WCSim README indica Geant4 10.3.3 come versione supportata
    # nel container hk-software. Qui usiamo quella per ridurre il rischio.
    # ==============================================================

    export GEANT4_VERSION=10.3.3
    export GEANT4_HOME=/usr/local/hk/Geant4
    export GEANT4_SRC=${GEANT4_HOME}/geant4.${GEANT4_VERSION}
    export GEANT4_BUILD=${GEANT4_HOME}/build-${GEANT4_VERSION}
    export GEANT4_INSTALL=${GEANT4_HOME}/install-${GEANT4_VERSION}

    mkdir -p ${GEANT4_HOME}
    cd ${GEANT4_HOME}

    wget -O geant4.${GEANT4_VERSION}.tar.gz https://gitlab.cern.ch/geant4/geant4/-/archive/v${GEANT4_VERSION}/geant4-v${GEANT4_VERSION}.tar.gz
    tar -xzf geant4.${GEANT4_VERSION}.tar.gz
    mv geant4-v${GEANT4_VERSION} ${GEANT4_SRC}

    mkdir -p ${GEANT4_BUILD}
    cd ${GEANT4_BUILD}

    cmake ${GEANT4_SRC} \
        -DCMAKE_INSTALL_PREFIX=${GEANT4_INSTALL} \
        -DGEANT4_INSTALL_DATA=ON \
        -DGEANT4_USE_OPENGL_X11=OFF \
        -DGEANT4_USE_QT=OFF \
        -DGEANT4_BUILD_MULTITHREADED=ON

    make -j$(nproc)
    make install

    source ${GEANT4_INSTALL}/bin/geant4.sh

    echo "Geant4 version:"
    geant4-config --version

    # ==============================================================
    # 4. Install complete WCSim
    # ==============================================================

    export WCSIM_HOME=/usr/local/hk/WCSimFull
    export WCSIM_SOURCE_DIR=${WCSIM_HOME}/WCSim
    export WCSIM_BUILD_DIR=${WCSIM_HOME}/build
    export WCSIM_INSTALL_DIR=${WCSIM_HOME}/install

    mkdir -p ${WCSIM_HOME}

    git clone https://github.com/WCSim/WCSim.git ${WCSIM_SOURCE_DIR}

    cd ${WCSIM_SOURCE_DIR}

    mkdir -p ${WCSIM_BUILD_DIR}
    cd ${WCSIM_BUILD_DIR}

    cmake ${WCSIM_SOURCE_DIR} \
        -DCMAKE_INSTALL_PREFIX=${WCSIM_INSTALL_DIR} \
        -DWCSim_WCSimRoot_only=OFF

    make -j$(nproc)
    make install

    # ==============================================================
    # 5. Script final environment (do not use)
    # ==============================================================

    cat > /usr/local/hk/fitqun_wcsim_env.sh <<'EOF'
#!/bin/bash

export FITQUN_SRC=/usr/local/hk/fiTQun
export FITQUN_INSTALL=/usr/local/hk/fiTQun/install-Linux_x86_64-gcc_8-python_3.12.1
export OLD_WCSIMROOT_INSTALL=/usr/local/hk/WCSimRoot/install-Linux_x86_64-gcc_8-python_3.12.1
export ROOT_INSTALL=/usr/local/hk/ROOT/install-Linux_x86_64-gcc_8-python_3.12.1

export GEANT4_INSTALL=/usr/local/hk/Geant4/install-10.3.3

export WCSIM_HOME=/usr/local/hk/WCSimFull
export WCSIM_SOURCE_DIR=/usr/local/hk/WCSimFull/WCSim
export WCSIM_BUILD_DIR=/usr/local/hk/WCSimFull/build
export WCSIM_INSTALL_DIR=/usr/local/hk/WCSimFull/install

export FITQUN_ROOT=$FITQUN_SRC

if [ -f ${ROOT_INSTALL}/bin/thisroot.sh ]; then
    source ${ROOT_INSTALL}/bin/thisroot.sh
fi

if [ -f ${GEANT4_INSTALL}/bin/geant4.sh ]; then
    source ${GEANT4_INSTALL}/bin/geant4.sh
fi

if [ -f ${WCSIM_INSTALL_DIR}/bin/this_wcsim.sh ]; then
    source ${WCSIM_INSTALL_DIR}/bin/this_wcsim.sh
fi

export PATH=$FITQUN_INSTALL/bin:$WCSIM_INSTALL_DIR/bin:$ROOT_INSTALL/bin:$PATH

# Nota:
# per fiTQun si tiene il vecchio WCSimRoot già funzionante.
# per WCSim usiamo anche le librerie della nuova installazione.
export LD_LIBRARY_PATH=$FITQUN_INSTALL/lib:$OLD_WCSIMROOT_INSTALL/lib:$WCSIM_INSTALL_DIR/lib:$ROOT_INSTALL/lib:/.singularity.d/libs:$LD_LIBRARY_PATH

export ROOT_INCLUDE_PATH=$OLD_WCSIMROOT_INSTALL/include/WCSimRoot:$OLD_WCSIMROOT_INSTALL/include:$WCSIM_INSTALL_DIR/include:$ROOT_INCLUDE_PATH

exec "$@"
EOF

    chmod +x /usr/local/hk/fitqun_wcsim_env.sh

    # Version report
    cat > /usr/local/hk/versions_fitqun_wcsim.txt <<EOF
Build date: $(date)

ROOT:
$(root-config --version)

Geant4:
$(geant4-config --version)

WCSim commit:
$(cd ${WCSIM_SOURCE_DIR} && git rev-parse HEAD)

fiTQun install:
${FITQUN_INSTALL}

Old WCSimRoot install:
${WCSIMROOT_INSTALL}

WCSim full install:
${WCSIM_INSTALL_DIR}
EOF

%environment
    export FITQUN_SRC=/usr/local/hk/fiTQun
    export FITQUN_INSTALL=/usr/local/hk/fiTQun/install-Linux_x86_64-gcc_8-python_3.12.1
    export ROOT_INSTALL=/usr/local/hk/ROOT/install-Linux_x86_64-gcc_8-python_3.12.1
    export GEANT4_INSTALL=/usr/local/hk/Geant4/install-10.3.3
    export WCSIM_HOME=/usr/local/hk/WCSimFull
    export WCSIM_SOURCE_DIR=/usr/local/hk/WCSimFull/WCSim
    export WCSIM_BUILD_DIR=/usr/local/hk/WCSimFull/build
    export WCSIM_INSTALL_DIR=/usr/local/hk/WCSimFull/install

%runscript
    echo "fiTQun + full WCSim test image"
    echo "Use:"
    echo "  bash /usr/local/hk/fitqun_wcsim_env.sh which WCSim"
    echo "  bash /usr/local/hk/fitqun_wcsim_env.sh which runfiTQun"
